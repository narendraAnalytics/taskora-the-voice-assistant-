# ---- Project notes and docs (kept local) ----
*.txt
*.md
# ...except the root README, the only .md file that gets committed
!/README.md

# ---- Dependencies ----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Next.js / build output ----
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ---- Testing ----
coverage/
playwright-report/
test-results/

# ---- Env and secrets ----
.env*
!.env.example
*.pem

# ---- Deploy ----
.vercel
.netlify

# ---- Logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---- Python (future backend) ----
__pycache__/
*.py[cod]
.venv/
venv/

# ---- Video (rendered locally, not committed) ----
*.mp4

